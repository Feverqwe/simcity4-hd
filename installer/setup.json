{
  "product": "SimCity 4 UHD",
  "projectUrl": "https://github.com/Feverqwe/simcity4-hd",
  "projectLinkText": "GitHub",
  "checkForUpdates": true,
  "detectTarget": true,
  "reconfigure": true,
  "textureArchives": true,
  "artwork": "screenshot.jpg",
  "readyText": "SimCity 4 Deluxe found. Close the game before installing the HD mod.",
  "progressText": "Images processed: %L1",
  "paths": [
    {
      "id": "game",
      "label": "Game location",
      "browse": "Select SimCity 4 Deluxe",
      "fileFilter": "SimCity 4 game files (*.exe *.app)",
      "inspectOnChange": true,
      "prompt": "Choose the Steam game folder, the Aspyr .app, or the game executable.",
      "required": true
    },
    {
      "id": "cache",
      "label": "Texture cache",
      "browse": "Select a texture cache folder",
      "default": "${SETUP_EXE_DIR}/SimCity4UHDCache"
    }
  ],
  "displayResolution": {
    "id": "resolution",
    "fallback": "auto",
    "automatic": true,
    "values": ["1280x720", "1600x900", "1920x1080", "2560x1440", "3440x1440", "3840x2160"],
    "editable": true,
    "platforms": { "windows": { "fallback": "3840x2160" } }
  },
  "options": [
    {
      "id": "keep-upscaled-images",
      "label": "Keep original upscaled images for future rebuilds",
      "default": false
    },
    {
      "id": "texture-scale",
      "label": "Texture scale",
      "default": "2",
      "values": [
        { "value": "2", "label": "×2 (downscaled from ×4)" },
        { "value": "4", "label": "×4" }
      ]
    },
    {
      "id": "ui",
      "label": "Upscale interface textures and apply UI fixes",
      "default": true,
      "group": "Interface"
    },
    {
      "id": "language",
      "label": "Game language",
      "default": "game",
      "localeDefaults": { "ru": "russian" },
      "localeDefaultFiles": ["Russian/russian.sc4pack"],
      "requires": "ui",
      "values": [
        { "value": "game", "label": "Game default" },
        { "value": "russian", "label": "Русский" }
      ]
    },
    {
      "id": "hd-cursors",
      "label": "Larger game cursors",
      "default": true,
      "requires": "ui"
    },
    {
      "id": "region-map",
      "label": "Larger region map",
      "default": true,
      "requires": "ui"
    },
    {
      "id": "loading-preview",
      "label": "Larger city loading preview",
      "default": true,
      "requires": "ui"
    },
    {
      "id": "retina-text",
      "label": "Render text at Retina density",
      "default": true,
      "requires": "ui",
      "target": "aspyr"
    },
    {
      "id": "world",
      "label": "Upscale world textures",
      "default": true,
      "group": "World"
    },
    {
      "id": "network",
      "label": "Roads and rail",
      "default": true,
      "requires": "world"
    },
    {
      "id": "terrain",
      "label": "Terrain",
      "default": true,
      "requires": "world"
    },
    {
      "id": "models",
      "label": "Buildings, props and effects",
      "default": true,
      "requires": "world"
    },
    {
      "id": "draw-stats",
      "label": "Enable renderer statistics",
      "targetLabels": {
        "windows": "Log renderer statistics",
        "aspyr": "Show the frame rate"
      },
      "default": false,
      "group": "Game launch"
    },
    {
      "id": "skip-intro",
      "label": "Skip the game intro",
      "default": true
    }
  ],
  "pausingText": "Pausing… Completed textures will be kept.",
  "pausedText": "Resume whenever you’re ready. Setup will reuse the textures already saved.",
  "installedText": "SimCity 4 UHD is installed. Close the game before changing its settings. To play, open SimCity 4 Deluxe in Steam.",
  "completionUrl": "steam://run/24780",
  "completionAction": "Play",
  "backendArgs": [
    "setup"
  ],
  "icon": "setup.ico",
  "platforms": {
    "macos": {
      "icon": null,
      "completionUrl": "steam://rungameid/24780",
      "sessionLogDirectory": "${HOME}/Library/Logs/SimCity4HD"
    }
  }
}
